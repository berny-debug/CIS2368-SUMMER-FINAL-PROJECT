<!DOCTYPE html>
<html>
<head>
  <title>Residence Management Login</title>
  <style>
    :root { --navy:#12344d; --blue:#2f6f9f; --light:#f5f7fa; --text:#243447; --danger:#c94b4b; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", Arial, sans-serif;
      background: linear-gradient(135deg, #eef4fa 0%, #f8fbff 100%);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .card {
      background: white;
      border-radius: 16px;
      padding: 32px;
      width: min(92%, 420px);
      box-shadow: 0 16px 40px rgba(18, 52, 77, 0.16);
    }
    h1 { margin-top: 0; color: var(--navy); font-size: 1.8rem; }
    p { color: #5c6b7a; }
    .error { color: var(--danger); background: #fdeaea; padding: 10px; border-radius: 8px; margin-bottom: 16px; }
    form { display: flex; flex-direction: column; gap: 12px; }
    input, button {
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid #d8e2ec;
      font-size: 1rem;
    }
    button {
      background: var(--blue);
      color: white;
      border: none;
      cursor: pointer;
      font-weight: 600;
      transition: background 0.2s ease;
    }
    button:hover { background: #255d87; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Residence Management</h1>
    <p>Sign in to manage floors, rooms, and residents.</p>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form method="POST" action="/login">
      <input name="username" placeholder="Username" required />
      <input name="password" type="password" placeholder="Password" required />
      <button type="submit">Login</button>
    </form>
  </div>
</body>
</html>
